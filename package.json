  "main": "index.js",
  "scripts": {
    "cy_open": "npx cypress open --e2e --browser chrome",
    "cy_run": "npx cypress run --e2e --browser chrome",
    "current": "npx cypress run --e2e --browser chrome --expose grepTags=@current",
    "purchase": "npx cypress run --e2e --browser chrome --expose grepTags=@purchase",
    "menProducts": "npx cypress run --e2e --browser chrome --expose grepTags=@menProducts",
